# ==============================================================================
# SolarWise AI — Environment Configuration Example
# ==============================================================================

# Your xAI / Grok API Key (From https://console.x.ai)
XAI_API_KEY=your_xai_api_key_here

# Grok Model Name (Default: grok-4.7 or grok-beta / grok-2-latest)
GROK_MODEL=grok-4.7

# Express Server Port
PORT=3000

# Python ML Microservice URL
PYTHON_SERVICE_URL=http://127.0.0.1:5001
